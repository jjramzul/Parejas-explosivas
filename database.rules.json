{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || data.child('members').child(auth.uid).exists() || (data.child('game').child('status').val() === 'waiting' && newData.child('members').child(auth.uid).exists()))",
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{6}$/) && newData.hasChildren(['host', 'createdAt', 'members']) && newData.child('members').numChildren() <= 4",
        "host": {
          ".validate": "newData.isString() && (data.exists() ? newData.val() === data.val() : newData.val() === auth.uid)"
        },
        "members": {
          "$uid": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
          }
        },
        "players": {
          "$p": {
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            }
          }
        }
      }
    }
  }
}